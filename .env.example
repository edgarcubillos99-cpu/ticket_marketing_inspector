# Ubersmith API (HTTP Basic Auth: usuario + token/password)
UBERSMITH_BASE_URL=https://billing.osnetpr.com/api/2.0/
UBERSMITH_USER=
UBERSMITH_TOKEN=
# Opcional: limitar resultados de ticket_list para pruebas
# UBERSMITH_LIMIT=10

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# MySQL remoto
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TABLE=tickets_osnet
# Opcional: true | skip-verify | preferred
# MYSQL_TLS=skip-verify

# Ejecución
WORKERS=3
# true = corre el flujo al arrancar y luego deja el cron activo
RUN_ON_START=false
# Domingo 1:00 am hora de Puerto Rico (nodo 1)
CRON_SPEC=0 1 * * 0
CRON_TZ=America/Puerto_Rico
