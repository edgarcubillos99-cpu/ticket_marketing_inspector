# Ubersmith API (HTTP Basic Auth: usuario + token/password)
UBERSMITH_BASE_URL=https://billing.osnetpr.com/api/2.0/
UBERSMITH_USER=
UBERSMITH_TOKEN=
# Opcional: limitar resultados de ticket_list para pruebas
# UBERSMITH_LIMIT=10

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# MySQL remoto
# Desde Docker en Linux usa host.docker.internal (requiere extra_hosts en compose)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_TABLE=tickets_osnet
MYSQL_TABLE_SOCIAL=redes_sociales_metricas
MYSQL_TABLE_ADS=anuncios_metricas
# Opcional: true | skip-verify | preferred
# MYSQL_TLS=skip-verify

# Ejecución
PORT=8080
WORKERS=3
# true = corre el flujo al arrancar y luego deja el cron activo
RUN_ON_START=false
# Domingo 1:00 am hora de Puerto Rico (tickets + redes + ads)
CRON_SPEC=0 1 * * 0
CRON_TZ=America/Puerto_Rico
# true = recorre mes a mes desde BACKFILL_FROM hasta hoy y termina (no deja el cron)
# BACKFILL=true
# BACKFILL_FROM=2024-01-01

# ---------------------------------------------------------------------------
# Marketing: redes sociales orgánicas + anuncios
# (opcionales: si faltan, el flujo de tickets sigue; marketing se omite)
# Ver INSTRUCCIONES_REDES_Y_ANUNCIOS.txt para cómo obtener cada valor.
# ---------------------------------------------------------------------------

# Cuántos meses hacia atrás refrescar en cada corrida semanal
MARKETING_MONTHS_LOOKBACK=3

# --- Meta (Facebook Page + Instagram Business + Meta Ads) ---
# Token de página de larga duración con permisos: pages_read_engagement,
# pages_show_list, instagram_basic, instagram_manage_insights, ads_read, read_insights
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# ID de cuenta publicitaria SIN el prefijo act_ (ej: 1234567890)
META_AD_ACCOUNT_ID=

# --- LinkedIn (página de empresa + Campaign Manager) ---
# Access token OAuth2 con scopes: r_organization_social, rw_organization_admin,
# r_ads, r_ads_reporting
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202411
# Solo el número de organización (ej: 12345678), sin urn:li:organization:
LINKEDIN_ORGANIZATION_ID=
# ID de cuenta de anuncios (sponsoredAccount), solo número
LINKEDIN_AD_ACCOUNT_ID=

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Customer ID sin guiones (ej: 1234567890)
GOOGLE_ADS_CUSTOMER_ID=
# Opcional: MCC / manager account sin guiones
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# Clasificación Residencial / Comercial por nombre de campaña (regex)
ADS_RESIDENCIAL_PATTERN=(?i)residenc|residential|\bres\b
ADS_COMERCIAL_PATTERN=(?i)comercial|commercial|business|\bcom\b|\bb2b\b
